# Copy to .env.local and fill in from the Firebase Console:
# Project Overview > Project settings > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAp5PcBQG70t3J-5oPbN4vkETeLoBMwZUA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tibay-gym.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tibay-gym
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tibay-gym.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=542615126141
NEXT_PUBLIC_FIREBASE_APP_ID=1:542615126141:web:5e9500cbacf35b31703114
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-P4JPJHT5YY

# IANA timezone used for gym-local calendar calculations such as derived age.
# Defaults to Asia/Taipei when omitted.
NEXT_PUBLIC_GYM_TIME_ZONE=Asia/Taipei

# Absolute origin the app is served from, e.g. https://reshape.example.com
# Used by the Print Check-in QR page to build the poster URL. Leave blank in
# local dev — it falls back to the current browser origin. Set once hosting is
# decided (see TASKLIST "Deployment & Hosting"). No trailing slash.
NEXT_PUBLIC_APP_URL=

# Server-only Firebase service account. Set separately in Vercel's intended
# environment. Never prefix these with NEXT_PUBLIC_. Project IDs must match.
FIREBASE_ADMIN_PROJECT_ID=tibay-gym
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Existing legitimate admin's Authentication UID. Synchronize rules identity
# with `npm run rfid:provision -- admin` BEFORE deploying firestore.rules.
FIREBASE_ADMIN_ALLOWED_UID=

# Isolated local attendance development: prefer `npm run dev:isolated`, which
# overrides .env.local with demo-only values and loopback Firestore/Auth hosts.
# No live credentials are used in isolated mode. Missing emulator settings fail closed.
NEXT_PUBLIC_FIREBASE_ISOLATED=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Optional: header your trusted reverse proxy OVERWRITES with one client IP.
# Leave unset for direct local dev (shared unknown-caller budget). Current
# hosted runtime automatically recognizes its trusted client-IP header.
# Never enable a caller-controlled header on a directly reachable server.
PUBLIC_RATE_LIMIT_IP_HEADER=

# Supabase receipt storage backend (Firebase still handles login and gym data).
# Server-only: never prefix the secret key with NEXT_PUBLIC_ or commit its value.
# Supabase dashboard > Project Settings > API Keys > existing secret key.
SUPABASE_URL=https://nqyavbidoixznjetehyv.supabase.co
SUPABASE_SECRET_KEY=

# Optional direct/pooler database connection used only to apply receipt migrations.
# Keep private. Alternatively run the saved migration in Supabase SQL Editor.
SUPABASE_DB_URL=
# Configure a server-only secret of at least 20 characters for scheduled receipt jobs.
# Schedule protected POST /api/receipts/worker and POST /api/images/cleanup.
# Send Authorization: Bearer <CRON_SECRET>; an authenticated admin can also run them.
CRON_SECRET=

# Android SMS Gateway: server-only. Local mode example http://192.168.1.10:8080
# Cloud mode example https://api.sms-gate.app/3rdparty/v1 (include API prefix).
# Prefer a scoped JWT token. Local/legacy mode can use the app's username/password.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_DEVICE_ID=
